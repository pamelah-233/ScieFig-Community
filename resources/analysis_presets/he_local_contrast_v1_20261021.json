{
  "name": "HE 局部对比分水岭",
  "algorithm": "he_local_contrast_v1",
  "description": "保留本轮传统 HE 核分割方案。新图片从本配置复制微调，不覆盖此基线。大圆形、内部浅染核尚未针对性适配。",
  "parameters": {
    "stain": "he",
    "method": "watershed",
    "diameter_px": 5,
    "min_area_px": 3,
    "max_area_px": 200,
    "sensitivity": 1.0,
    "he_settings": {
      "clip_percentile": 99.0,
      "smooth_sigma": 0.65,
      "background_scale": 1.0,
      "contrast_threshold_fraction": 0.25,
      "signal_threshold_fraction": 0.4,
      "curvature_scale": 0.2,
      "curvature_ratio": 0.04,
      "minimum_width_fraction": 0.22,
      "seed_distance_fraction": 0.4,
      "minimum_circularity": 0.25
    }
  }
}
